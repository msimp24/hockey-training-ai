<div class="container">
  <div class="dashboard-row">
    <div class="token-wrapper">
      <h1 class="h2-dashboard" id="user-tokens"></h1>
      <button id="add-tokens-btn">Add Tokens</button>
    </div>
  </div>
  <div class="dashboard-row">
    <div class="table-container">
      <table>
        <tr>
          <th># of Phases</th>
          <th>Phase Focus</th>
          <th>Phase Cost</th>
          <th>Program Length</th>
          <th></th>
        </tr>
        <tbody>
          <tr>
            <td>1 Phase</td>
            <td>
              Choose one of Strength, Power, Speed, Cardio for a 4 week program
              targetting that focus area
            </td>
            <td>15 Tokens</td>
            <td>4 Weeks</td>
            <td>
              <button data-id="1" class="purchase-btn">Purchase</button>
            </td>
          </tr>
          <tr>
            <td>2 Phases</td>
            <td>
              Full 8 week program that includes 4 weeks of general strength and
              4 weeks of Power, Speed and Cardio
            </td>
            <td>30 Tokens</td>
            <td>8 Weeks</td>
            <td><button data-id="2" class="purchase-btn">Purchase</button></td>
          </tr>
          <tr>
            <td>3 Phases</td>
            <td>
              Full 12 week program that will cover all areas of training
              including, Strength, Power, Speed and Cardio
            </td>
            <td>45 Tokens</td>
            <td>12 Weeks</td>
            <td><button data-id="3" class="purchase-btn">Purchase</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="container">
  <div class="modal-overlay"></div>
</div>
