<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hockey Training AI Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="icon" type="image/png" href="/images/fav-icon.png" />
  </head>

  <body class="dashboard-background">
    <div class="container">
      <div class="dash-top-nav">
        <a href="/" class="logo">HockeyTrainingAI</a>
        <div class="wrapper">
          <p id="curr-user"></p>
          <a href="/dashboard/profile/edit-account"
