<form class="register-form" id="reset-pass-form">
  <h2>Reset Password</h2>
  <div class="input-box">
    <label for="password">Email</label>
    <input type="password" name="new-password" id="new-password" />
    <p class="error-text" id="new-pass-err"></p>
  </div>

  <div class="input-box">
    <label for="password">Email</label>
    <input
      type="password"
      name="confirm-new-password"
      id="confirm-new-password" />
    <p class="error-text" id="confirm-new-pass-err"></p>
  </div>
  <button id="reset-password">Login</button>
</form>
