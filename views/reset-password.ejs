<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/forms.css" />

    <title>Hockey Training AI</title>
  </head>
  <body>
    <div class="form-background layout">
      <form class="register-form" id="reset-pass-form">
        <h2>Reset Password</h2>
        <div class="input-box">
          <label for="password">New Password</label>
          <input type="password" name="new-password" id="new-password" />
          <p class="error-text" id="pass-err"></p>
        </div>

        <div class="input-box">
          <label for="password">Confirm New Password</label>
          <input
            type="password"
            name="confirm-new-password"
            id="confirm-new-password" />
          <p class="error-text" id="confirm-pass-err"></p>
        </div>
        <button id="reset-password-btn">Submit</button>
      </form>
    </div>
    <script src="/js/reset-password.js"></script>
  </body>
</html>
