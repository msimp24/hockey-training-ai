<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hockey AI Training</title>
    <link rel="stylesheet" href="/css/forms.css" />
  </head>
  <body>
    <div class="form-background layout">
      <h1>Hockey Training AI</h1>
      <form class="register-form" id="login-form">
        <h2>Login</h2>
        <div class="input-box">
          <label for="email">Email</label>
          <input type="text" name="email" id="log-email" />
          <p class="error-text" id="log-email-err"></p>
        </div>

        <div class="input-box">
          <label for="password">Password</label>
          <input type="password" name="password" id="log-password" />
          <p class="error-text" id="log-password-err"></p>
        </div>

        <button id="login-btn">Login</button>
        <a href="/register" class="new-account-link"
          >New User? Create account here</a
        >
      </form>
    </div>
    <script type="module" src="/js/login.js"></script>
  </body>
</html>
