<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hockey Training AI</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="hero">
      <div class="container">
        <nav class="nav">
          <div class="logo">
            <a href="/">HockeyTrainingAI</a>
          </div>
          <div class="nav-btn-container">
            <button id="register-btn">Try Free</button>
            <button id="login" class="login-btn">Login</button>
            <button id="dashboard-btn">Workouts</button>
          </div>
        </nav>

        <div class="hero-content">
          <h1 class="hero-title">Take your hockey game to the next level</h1>
          <p class="hero-description">
            Use AI to create your custom hockey workout program based on your
            skill level and equipment. At a fraction of the cost!
          </p>
          <div class="nav-btn-container">
            <button id="learn-more-btn">Learn More</button>
            <button id="get-started-btn">Get Started</button>
          </div>
        </div>
      </div>
    </div>
  </body>
  <script type="module" src="/js/main.js"></script>
</html>
