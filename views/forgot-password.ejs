<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/forms.css" />

    <title>Hockey Training AI</title>
  </head>
  <body>
    <div class="form-background layout">
      <form class="register-form" id="forgot-pass-form">
        <h2>Reset password</h2>
        <div class="input-box">
          <label for="email">Enter Email:</label>
          <input
            type="text"
            name="email-new-password"
            id="email-new-password" />
          <p class="error-text" id="new-pass-err"></p>
        </div>
        <button id="forgot-password-btn">Submit</button>
      </form>
    </div>
    <script src="/js/reset-password.js"></script>
  </body>
</html>
